# Where decks are stored (gzipped JSON, one file per deck). Docker mounts a volume here.
DATA_DIR=./data
# Days a shared deck lives after its last publish.
DECK_TTL_DAYS=30
# Hard cap on the whole store; publishing fails with 507 when it would be exceeded.
STORE_MAX_MB=2048
# Max size of one deck (JSON incl. embedded images).
DECK_MAX_MB=15
